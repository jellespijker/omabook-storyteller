{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/session_context.py\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/pretool_guard.py\"", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/post_edit_check.py\"", "timeout": 120 }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/secrets/**)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)"
    ]
  }
}
